# === VYBLA env ===
# Telegram
BOT_TOKEN=123456:ABC-yourbottoken
BOT_USERNAME=vybla_bot

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJhbGciOi...   # service_role key (server side only)

# Redis (Upstash works: rediss://default:PASS@host:port)
REDIS_URL=redis://localhost:6379/0

# Public https base URL of this service (Railway/Replit gives you one)
WEBHOOK_URL=https://your-app.up.railway.app

# Random long string; used to hash sender identity. CHANGE THIS.
HASH_SALT=change_me_to_a_long_random_string

# Optional: extra header secret Telegram sends back to us
WEBHOOK_SECRET=another_random_string

# Optional: your telegram user id — receives report alerts
ADMIN_ID=7962826264

# Optional: AI banter in the group (Ева/Макс dialogue, see dialogue.py).
# Leave OPENROUTER_API_KEY empty to use the free scripted fallback bank only.
# Get a key at https://openrouter.ai/keys. deepseek/deepseek-chat tested best
# for natural Russian at ~$0.0001/call (llama-3.1-8b mixed in English,
# qwen-2.5-7b broke into Chinese) — check openrouter.ai/models for current
# pricing before changing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
